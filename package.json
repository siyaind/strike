{
  "name": "strike",
  "private": true,
  "version": "0.1.0",
  "description": "STRIKE G2 — See the market. Understand the risk. Make your move.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --filter ./apps/** run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "pnpm --filter @strike/api dev",
    "dev:glasses": "pnpm --filter @strike/glasses dev",
    "dev:companion": "pnpm --filter @strike/companion dev",
    "build": "pnpm -r --filter ./apps/** run build",
    "e2e": "pnpm --filter @strike/companion e2e",
    "sim": "node scripts/sim-verify.mjs",
    "pack:g2": "pnpm --filter @strike/glasses pack"
  },
  "devDependencies": {
    "@playwright/test": "^1.56",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
