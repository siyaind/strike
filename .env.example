# STRIKE API — copy to .env (never commit .env)
PORT=8899
STRIKE_PUBLIC_ORIGIN=http://localhost:3100
STRIKE_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:5180
# 32+ random bytes (hex/base64). Signs single-use confirmation tokens.
STRIKE_CONFIRM_SECRET=
# 32 bytes base64. Encrypts testnet agent keys at rest. Keep outside the repo.
STRIKE_SIGNER_KEK=
# Optional. Free CoinGecko Demo key (owner must create one). Without it STRIKE uses the keyless public API at 5 req/min.
COINGECKO_DEMO_API_KEY=
# Optional. OpenAI-compatible transcription endpoint (see services/stt).
STRIKE_STT_URL=
STRIKE_STT_KEY=
STRIKE_STT_MODEL=
STRIKE_GUEST_TTL_MS=7200000
STRIKE_MAX_GUESTS=500
# Companion
NEXT_PUBLIC_STRIKE_API=http://localhost:8899
# Glasses (Vite)
VITE_STRIKE_API=http://localhost:8899
