  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@strike/visual-engine": "workspace:*",
    "@strike/voice-engine": "workspace:*"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
